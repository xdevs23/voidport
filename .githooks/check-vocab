#!/usr/bin/env bash
# Vocabulary gate: the words this project does not write.
#
# The list below is filler jargon — words that sound like a decision and say
# nothing. Every one of them has a plainer replacement that carries the same
# meaning ("instead of", "decided", "justified", "connection", "note"), so the
# rule is a flat ban and the fix is always a rewrite, never a synonym hunt.
#
# Rules, deliberately blunt:
#   * whole words, any casing; "rather than" is the one banned as a phrase; (vocab-ok: the rule states its own list)
#   * a word boundary is any non-alphanumeric character, so an identifier
#     hides nothing: a banned word joined by underscores in a test name is
#     the same word;
#   * only ADDED lines are judged — the staged diff at commit time, and every
#     tracked line under `--all`, because this project publishes a fresh root
#     and the whole tree therefore counts as newly written;
#   * a line carrying `vocab-ok` is exempt. That is the escape for the one
#     legitimate case: an identifier that already spells a banned word and
#     cannot be renamed. It is a comment on the same line, so the exemption is
#     visible where it applies and reviewable in the diff that adds it.
#
# `.githooks/pre-commit` runs this both ways: the staged diff on commit, and
# the whole tree under `--all` (which is what `./check` runs).
set -euo pipefail

words='rather[ _]than|worth|leg|lane|doctrine|caveat|twist|ruling|ruled|seat|belt-and-suspenders|wrinkle|guessing' # vocab-ok: the list itself

# The words with their boundaries: anything that is not a letter or a digit
# separates words, which is what lets a snake_case identifier be judged as
# the words it joins. `grep -w` cannot say this — an underscore is a word
# character to it — so the boundary is spelled out.
bounded="(^|[^[:alnum:]])($words)([^[:alnum:]]|\$)"

refuse() {
  echo "vocab: refusing. These words are banned in tracked content." >&2
  echo "Rewrite the line, or mark a legitimate identifier with a" >&2
  echo "'vocab-ok' comment on the same line." >&2
  exit 1
}

# Reads `file:line:text` and reports every line that uses a banned word.
judge() {
  local entry rest file line text hits bad=0
  while IFS= read -r entry || [ -n "$entry" ]; do
    [ -z "$entry" ] && continue
    file=${entry%%:*}
    rest=${entry#*:}
    line=${rest%%:*}
    text=${rest#*:}
    case $text in *vocab-ok*) continue ;; esac
    hits=$(printf '%s\n' "$text" | grep -oiE "$bounded" \
      | sed -E 's/^[^[:alnum:]]+//; s/[^[:alnum:]]+$//' \
      | sort -fu | paste -sd' ' -) || true
    [ -z "$hits" ] && continue
    echo "vocab: $file:$line: $hits" >&2
    bad=1
  done
  return "$bad"
}

# Every added line of the staged change, as `file:line:text`.
#
# One diff, one awk. The hunk header carries the first new line number and how
# many lines follow on each side, so the pass counts its way through a hunk
# instead of inferring from the leading character — which keeps added content
# that itself starts with `+++` or `@@` out of the header rules.
staged() {
  git diff --cached -U0 --diff-filter=ACMR | awk '
    left + right == 0 {
      if (/^\+\+\+ /) { f = substr($0, 5); sub(/^b\//, "", f) }
      else if (/^@@ /) {
        old = $2; sub(/^-/, "", old)
        new = $3; sub(/^\+/, "", new)
        left  = (index(old, ",") ? substr(old, index(old, ",") + 1) : 1) + 0
        n     = (index(new, ",") ? substr(new, 1, index(new, ",") - 1) : new) + 0
        right = (index(new, ",") ? substr(new, index(new, ",") + 1) : 1) + 0
      }
      next
    }
    /^\+/ { printf "%s:%d:%s\n", f, n, substr($0, 2); n++; right-- }
    /^-/  { left-- }
  '
}

if [ "${1:-}" = "--all" ]; then
  # `git grep` prefilters with the same expression, so only candidate lines
  # are judged one at a time — the whole tree costs one pass.
  candidates=$(git grep -IniE "$bounded" -- . || true)
  printf '%s\n' "$candidates" | judge || refuse
else
  # Same shape for the staged diff: one `grep` prefilters the reconstructed
  # lines, so judging only ever sees candidates. The prefix `file:line:` is in
  # the grepped text and can only widen the candidate set, never narrow it —
  # `judge` looks at the text alone and drops whatever the path pulled in.
  candidates=$(staged | grep -iE "$bounded" || true)
  printf '%s\n' "$candidates" | judge || refuse
fi
